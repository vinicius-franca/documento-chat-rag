# Copie este arquivo para .env e preencha somente os valores locais.
PORT=3000

# Infraestrutura local
POSTGRES_DB=livrochat
POSTGRES_USER=livrochat
POSTGRES_PASSWORD=livrochat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=book_chunks
EMBEDDING_DIMENSIONS=1536

# IA — não versionar uma chave real.
# OpenRouter é o padrão. OPENAI_API_KEY é aceito temporariamente como fallback
# para facilitar a migração de uma chave já configurada.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_GENERATION_MODEL=openai/gpt-4.1-mini

# Para usar a API OpenAI diretamente, defina AI_PROVIDER=openai e preencha:
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4.1-mini

# Parâmetros iniciais do MVP
MAX_UPLOAD_SIZE_BYTES=52428800
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RAG_TOP_K=6
